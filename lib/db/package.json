{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./supabase": "./src/supabase-connection.ts",
    "./schema-compatibility": "./src/schema-compatibility.ts",
    "./supabase-readiness": "./src/supabase-readiness.ts",
    "./supabase-schema-plan": "./src/supabase-schema-plan.ts",
    "./supabase-data-migration": "./src/supabase-data-migration.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
